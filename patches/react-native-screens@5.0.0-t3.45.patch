diff --git a/ios/helpers/stack/RNSStackNavigationController.mm b/ios/helpers/stack/RNSStackNavigationController.mm
--- a/ios/helpers/stack/RNSStackNavigationController.mm
+++ b/ios/helpers/stack/RNSStackNavigationController.mm
@@ -33,15 +33,45 @@
   UIViewController *destination = navigation.viewControllers[navigation.viewControllers.count - 2];
   if ([navigation shouldPreventNativePopToController:destination])
     return NO;
+  // UIKit's delegate rejects a hidden navigation bar even when the screen supplies its own Back control.
+  if (navigation.navigationBarHidden) {
+    CGPoint start = [gestureRecognizer locationInView:navigation.view];
+    if ([gestureRecognizer isKindOfClass:UIPanGestureRecognizer.class]) {
+      CGPoint translation = [(UIPanGestureRecognizer *)gestureRecognizer translationInView:navigation.view];
+      start.x -= translation.x;
+    }
+    BOOL rtl = navigation.view.effectiveUserInterfaceLayoutDirection == UIUserInterfaceLayoutDirectionRightToLeft;
+    BOOL startsAtEdge = rtl ? start.x >= navigation.view.bounds.size.width - 32 : start.x <= 32;
+    return startsAtEdge && navigation.transitionCoordinator == nil && navigation.presentedViewController == nil;
+  }
   if ([self.originalDelegate respondsToSelector:_cmd]) {
     return [self.originalDelegate gestureRecognizerShouldBegin:gestureRecognizer];
   }
   return YES;
 }
 
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceiveTouch:(UITouch *)touch
+{
+  if (self.navigationController.navigationBarHidden)
+    return YES;
+  if ([self.originalDelegate respondsToSelector:_cmd])
+    return [self.originalDelegate gestureRecognizer:gestureRecognizer shouldReceiveTouch:touch];
+  return YES;
+}
+
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceiveEvent:(UIEvent *)event
+{
+  if (self.navigationController.navigationBarHidden)
+    return YES;
+  if ([self.originalDelegate respondsToSelector:_cmd])
+    return [self.originalDelegate gestureRecognizer:gestureRecognizer shouldReceiveEvent:event];
+  return YES;
+}
+
 - (BOOL)respondsToSelector:(SEL)selector
 {
-  return [super respondsToSelector:selector] || [self.originalDelegate respondsToSelector:selector];
+  return [super respondsToSelector:selector] ||
+      (!self.navigationController.navigationBarHidden && [self.originalDelegate respondsToSelector:selector]);
 }
 
 - (id)forwardingTargetForSelector:(SEL)selector
diff --git a/ios/helpers/stack/RNSStackNavigationBarCoordinator.mm b/ios/helpers/stack/RNSStackNavigationBarCoordinator.mm
--- a/ios/helpers/stack/RNSStackNavigationBarCoordinator.mm
+++ b/ios/helpers/stack/RNSStackNavigationBarCoordinator.mm
@@ -9,6 +9,11 @@
                    animated:(BOOL)animated
 {
   [navigationController setNavigationBarHidden:hidden animated:animated];
+#if !TARGET_OS_TV
+  if (hidden) {
+    navigationController.interactivePopGestureRecognizer.enabled = YES;
+  }
+#endif
 }
 
 #if !TARGET_OS_TV
diff --git a/ios/stack/screen/RNSStackScreenController.mm b/ios/stack/screen/RNSStackScreenController.mm
--- a/ios/stack/screen/RNSStackScreenController.mm
+++ b/ios/stack/screen/RNSStackScreenController.mm
@@ -69,6 +69,12 @@
 {
   [super viewDidAppear:animated];
   [self.headerCoordinator restoreDetachedTitleView];
+#if !TARGET_OS_TV
+  // UIKit disables edge-pop when a push hides the bar; restore it after that transition finishes.
+  if (self.navigationController.navigationBarHidden) {
+    self.navigationController.interactivePopGestureRecognizer.enabled = YES;
+  }
+#endif
   [[self reactEventEmitter] emitOnDidAppear];
 }
 
